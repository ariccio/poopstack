# pnpm settings for the development tooling (the mod itself has no dependencies).

# Exact versions only: every tool version is a deliberate, reviewed choice.
save-exact=true

# Refuse any package version younger than 14 days (20160 minutes), so a freshly
# published, possibly compromised release never lands here by accident.
minimum-release-age=20160

# The packageManager field in package.json names the one pnpm version to use.
package-manager-strict=true

auto-install-peers=true
strict-peer-dependencies=true
